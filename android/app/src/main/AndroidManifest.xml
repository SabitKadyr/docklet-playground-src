<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- versionCode/versionName live here so make_apk.sh (raw aapt2, no Gradle)
         produces a properly versioned APK. Gradle's defaultConfig overrides
         these with the same values when building through Android Studio. -->

    <!-- Live camera in the expanded dock: the page calls getUserMedia, WebView
         forwards it to MainActivity.onPermissionRequest, which needs this. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Haptics: navigator.vibrate() in WebView is a silent no-op unless the app holds this. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:debuggable="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.Docklet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Docklet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
